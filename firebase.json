{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "functions": {
    "source": "firebase/functions",
    "ignore": [
      "node_modules",
      ".git",
      "seed.js",
      "*.local"
    ]
  },
  "hosting": {
    "public": "site",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "build.py",
      "mangatct-site-standalone.html",
      "mangatct-site.zip",
      "mangatct-logos.zip"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/get/**",
        "function": {
          "functionId": "get",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
